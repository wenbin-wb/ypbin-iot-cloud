<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-cloud-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-iot-cloud-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-cloud-business</artifactId>

    <name>${project.artifactId}</name>
    <description>部署单元② 业务服务：装配 auth / core / openapi 三个库（M0a 仅可启动骨架）</description>

    <dependencies>
        <!-- 部署单元② 由这三个库装配而成（IOT-CLOUD-SPEC.md §4.2） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-openapi</artifactId>
        </dependency>
        <!-- 租约契约：控制器直接暴露 /internal/lease/** 的 DTO（与 access 侧同一份契约） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-api</artifactId>
        </dependency>
        <!-- 入站守卫（/internal/** 的 X-Internal-Token 校验，fail-closed） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-common</artifactId>
        </dependency>
        <!-- 统一异常：把守卫/业务抛的 BusinessException 转成 HTTP 200 + R.code（P1 已核实它在 starter-web 里） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查端点（P3/P5 用 curl /actuator/health 验收） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- lombok 在各模块都是 optional（不传递），用到就要显式声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          MockMvc 测试支持（@AutoConfigureMockMvc）：Spring Boot 4 把它从
          spring-boot-test-autoconfigure 拆到了 spring-boot-webmvc-test，
          包名也从 org.springframework.boot.test.autoconfigure.web.servlet 变为
          org.springframework.boot.webmvc.test.autoconfigure——**starter-test 不再带它**，必须显式声明。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本必须显式写：BOM import 不传递 pluginManagement（同 gateway 模块的说明） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
