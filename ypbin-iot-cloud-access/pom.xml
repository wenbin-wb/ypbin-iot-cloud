<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-cloud-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-iot-cloud-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-cloud-access</artifactId>

    <name>${project.artifactId}</name>
    <description>部署单元③ 设备接入（有状态）：M0a 仅可启动骨架，P4 才接 ypbin-iot-starter</description>

    <dependencies>
        <!--
          ⚠️ P0 故意**不**依赖 cn.ypbin:ypbin-iot-bom / 协议模块。

          iot-starter 尚未发布（0.1.0-SNAPSHOT 未上 Maven Central），现在引入会让干净环境构建失败。
          P4 接入步骤：
            ① 在 ypbin-iot-cloud-dependencies 放开 ypbin-iot-bom 的 import（那里有占位说明）；
            ② 这里按需引协议模块（mqtt / modbus / opcua / tcp）。
          P0 的 access 只验证「有状态的第三单元能被单独启动与探活」。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查端点（P5 用 curl /actuator/health 验收）+ Micrometer 指标（P4 退出条件：续约/失效可观测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 租约契约（ILeaseClient 的 Feign 声明、DTO、超时与 NEVER_RETRY、出站内部令牌拦截器） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-api</artifactId>
        </dependency>
        <!-- InternalProperties：出站内部令牌的值来源（与入站守卫同一份配置） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-common</artifactId>
        </dependency>
        <!-- R / GlobalErrorCode / LogSanitizer：统一信封判定与日志脱敏 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-core</artifactId>
        </dependency>
        <!--
          必需，不是可选项：**Feign 响应里就有 R 信封**（含 LocalDateTime 的 timestamp）。
          starter 的 Jackson 定制（时间格式、Long→String 等）在 **starter-json**，本模块是经
          starter-web 把它带进来的（复核实测：同时移除 starter-web 与 starter-json 才会出现
          `feign.codec.DecodeException: Cannot deserialize LocalDateTime from "2026-09-19 10:37:27"`，
          注册握手直接失败）。所以这里引 starter-web 是「顺带拿到 json 定制 + 统一信封」。
        -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <!--
          M0a 关 Nacos（spec §4.5），Feign 走 Spring Cloud 的 simple 发现：
          服务实例地址在 yml 的 spring.cloud.discovery.client.simple.instances 下配。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- lombok 在各模块都是 optional（不传递），用到就要显式声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本必须显式写：BOM import 不传递 pluginManagement（同 gateway 模块的说明） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
