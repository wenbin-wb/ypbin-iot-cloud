<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-cloud-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-iot-cloud-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-cloud-access</artifactId>

    <name>${project.artifactId}</name>
    <description>部署单元③ 设备接入（有状态）：P4 租约与 self-fencing，P4b 接 ypbin-iot-starter 协议栈</description>

    <dependencies>
        <!--
          ===== P4b：接 iot-starter（协议栈）=====

          `ypbin-iot-spring-boot-starter` 提供 `IotLifecycle`（bind/unbind/probe/sessions）与三个宿主 SPI 的装配；
          `ypbin-iot-protocol-tcp` 提供 TCP 透传适配器（M0a 用它做真建链/真断链的验证——MQTT 需要
          EMQX 而 M0a 明确不接 EMQX，见 spec §P4 与「M0a 明确不做」）。

          ⚠️ 这两个坐标来自 **BOM import**（`ypbin-iot-cloud-dependencies`），版本不在这里写；
          而 BOM 本身来自本机 `~/.m2` 的 iot-starter SNAPSHOT（该框架未发布，见其 ROADMAP）。
        -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-tcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查端点（P5 用 curl /actuator/health 验收）+ Micrometer 指标（P4 退出条件：续约/失效可观测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 租约契约（ILeaseClient 的 Feign 声明、DTO、超时与 NEVER_RETRY、出站内部令牌拦截器） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-api</artifactId>
        </dependency>
        <!-- InternalProperties：出站内部令牌的值来源（与入站守卫同一份配置） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-cloud-common</artifactId>
        </dependency>
        <!-- R / GlobalErrorCode / LogSanitizer：统一信封判定与日志脱敏 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-core</artifactId>
        </dependency>
        <!--
          必需，不是可选项：**Feign 响应里就有 R 信封**（含 LocalDateTime 的 timestamp）。
          starter 的 Jackson 定制（时间格式、Long→String 等）在 **starter-json**，本模块是经
          starter-web 把它带进来的（复核实测：同时移除 starter-web 与 starter-json 才会出现
          `feign.codec.DecodeException: Cannot deserialize LocalDateTime from "2026-09-19 10:37:27"`，
          注册握手直接失败）。所以这里引 starter-web 是「顺带拿到 json 定制 + 统一信封」。
        -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <!--
          M0a 关 Nacos（spec §4.5），Feign 走 Spring Cloud 的 simple 发现：
          服务实例地址在 yml 的 spring.cloud.discovery.client.simple.instances 下配。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- lombok 在各模块都是 optional（不传递），用到就要显式声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本必须显式写：BOM import 不传递 pluginManagement（同 gateway 模块的说明） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
