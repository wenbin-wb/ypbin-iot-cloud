<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-cloud</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-cloud-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>本仓统一依赖版本管理，同时作为全部子模块的 parent（含覆盖率门禁配置）</description>

    <properties>
        <!--
          设备接入框架（cn.ypbin:ypbin-iot-starter）的版本。
          该框架**尚未发布**（0.1.0-SNAPSHOT 未上 Maven Central，见 IOT-CLOUD-SPEC.md §11），
          因此下面的 ypbin-iot-bom import 保持注释状态；access 在 P4 才接 iot-starter。
        -->
        <ypbin.iot.version>0.1.0-SNAPSHOT</ypbin.iot.version>

        <!--
          共享内核（cn.ypbin:ypbin-starter-*）的版本，**必须在这里显式重管**。

          为什么不能省：本仓 parent = cn.ypbin:ypbin-starter-dependencies，而该父 pom 用它自己的
          ${revision} 来管理 ypbin-starter-* 的版本。子项目一旦定义自己的 <revision>
          （本仓 = 0.1.0-SNAPSHOT），继承下来的 management 就会把 ypbin-starter-core 之类
          解析成 **0.1.0-SNAPSHOT**（子项目自己的版本）→ 干净环境直接「Could not find artifact」。
          ypbin-iot-starter 之所以没踩到，是因为它不依赖任何 starter 运行时模块（只借父 pom 的插件与门禁 profile）。

          规则：**本仓每新增一个 starter 依赖，都必须同时加进下面的 dependencyManagement**；
          新增 starter 版本时只改这一个属性。
        -->
        <ypbin-starter.version>3.4.0</ypbin-starter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              ===== ypbin-iot-bom import（P4b 起启用）=====

              两个启用条件已在 2026-09-19 全部满足：
                ① `cn.ypbin:ypbin-iot-bom` 可解析 —— 由本机
                   `mvn -f ../ypbin-iot-starter/pom.xml -DskipTests install` 装进 `~/.m2`
                   （该框架仍未发布到 Central，见 IOT-CLOUD-SPEC.md §11 与它自己的 ROADMAP
                   「先让 access 用 SNAPSHOT 跑通、再发 0.1.0」）；
                ② access 开始接 iot-starter（P4b）。

              ⚠️ 因此本仓的**干净环境构建依赖 `~/.m2` 里的 iot SNAPSHOT**：新机器/CI 必须先装 iot-starter，
              否则会在这里失败（失败点是「解析不到 BOM」，比某个模块编译失败更好定位）。

              放开后 access 只引 BOM，不写具体协议模块版本（协议模块按需引入：M0a/P4b 用 tcp）。
            -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-bom</artifactId>
                <version>${ypbin.iot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ===== 共享内核（显式钉版本，理由见上方 ypbin-starter.version 注释）===== -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-core</artifactId>
                <version>${ypbin-starter.version}</version>
            </dependency>
            <!--
              统一响应「HTTP 200 + R.code」的全局异常处理器住在 ypbin-starter-web 里
              （common 只依赖 starter-core，本身不带 Web 层）——P3 起 business 需显式引入它，
              否则入站守卫抛出的 BusinessException 不会被转成 HTTP 200 + R.code=401。
            -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-web</artifactId>
                <version>${ypbin-starter.version}</version>
            </dependency>
            <!-- 网关支撑（GlobalFilter：鉴权/身份头清洗/请求 ID/异常处理；传递 spring-cloud-starter-gateway-server-webflux） -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-cloud-gateway</artifactId>
                <version>${ypbin-starter.version}</version>
            </dependency>
            <!--
              starter-web 的传递依赖也必须显式钉版本：starter 侧用 CI-friendly 的 ${revision}，
              而本仓也定义了同名属性（0.1.0-SNAPSHOT），于是 starter-web → starter-json 会解析成
              0.1.0-SNAPSHOT 而「找不到构件」（P0 已踩过一次，属同一根因）。
              凡新增 starter 模块依赖，都要在这里补一条。
            -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-json</artifactId>
                <version>${ypbin-starter.version}</version>
            </dependency>

            <!-- ===== 本仓模块（版本统一由 revision 控制）===== -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-auth</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-openapi</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-gateway</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-business</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-cloud-access</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 测试基座：全部模块统一 JUnit 5 + AssertJ + Boot 测试支持（与母仓同构） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              覆盖率门禁（M0a 第一批门禁的第 5 项）。

              父 pom 把 jacoco-check 绑在 test 阶段、BUNDLE 指令覆盖率下限 0.80；
              本仓**保持 spec §9.1 第 9 项的原值：指令 >= 0.80、分支 >= 0.64**（不放宽阈值）。
              骨架期之所以能过：目前唯一被真正度量的模块是 `-common`（唯一有测试的模块，指令 13/13），
              其余模块因 surefire 不产生 `jacoco.exec` 而被 jacoco 静默跳过（见下方"已知边界"）。
              （届时同步改 tools/export-coverage.mjs 的 GATE 常量，两处必须一致）。

              必须在 execution 级用 combine.self="override" 覆盖：父 pom 的 rules 定义在
              jacoco-check 执行内，插件级 configuration 不生效。

              已知边界（M0b 处理）：模块若没有测试，surefire 不产生 jacoco.exec，
              report/check 会以「missing execution data file」跳过 —— 也就是「有主源码但没测试」
              的模块会静默绕过本门禁。M0b 的覆盖率快照门禁（tools/export-coverage.mjs 的 check 模式）
              负责把这种「门禁空转」暴露出来（见 IOT-CLOUD-SPEC.md §9.1 第 8 项）。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!--
                      启动类（*Application）不参与覆盖率统计：它们只有一行 SpringApplication.run，
                      M0a 阶段不写 @SpringBootTest（本机 2 vCPU，"三单元能起"是 P5 的运行期验收，
                      不是单测），留在 bundle 里会让这三个部署单元永久 0%、门禁必红。
                      这是**显式声明豁免**，不是放宽阈值。
                    -->
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <configuration>
                            <rules combine.self="override">
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 与 spec §9.1 第 9 项一致：指令覆盖率 >= 0.80 -->
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 与 spec §9.1 第 9 项一致：分支覆盖率 >= 0.64 -->
                                            <minimum>0.64</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
